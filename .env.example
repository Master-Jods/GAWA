# ===========================================================================
# GAWA — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file with real secrets.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase — REQUIRED (all environments)
# ---------------------------------------------------------------------------
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-only. Never prefix with NEXT_PUBLIC_ or VITE_.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SECRET_KEY=<your-service-role-secret-key>

# Optional: Direct PostgreSQL connection (for migrations via psql)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Session & Token Security — REQUIRED (production)
# ---------------------------------------------------------------------------
# Used to sign server-issued session tokens if applicable.
# Generate: node -e "require('crypto').randomBytes(64).toString('hex')"
SESSION_SECRET=<64-hex-character-random-string>

# AES-256-GCM key for encrypting TOTP secrets at rest.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
# Must be exactly 64 hex characters (32 bytes).
TOTP_ENCRYPTION_KEY=<64-hex-character-random-string>

# ---------------------------------------------------------------------------
# Google OAuth / OpenID Connect — REQUIRED for Google SSO
# ---------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com
# 2. Create OAuth 2.0 credentials (Web application type)
# 3. Add authorized redirect URI: https://<your-domain>/api/auth/google/callback
# 4. Also configure in Supabase Dashboard → Auth → Providers → Google
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://<your-domain>/api/auth/google/callback

# ---------------------------------------------------------------------------
# SMTP Email — REQUIRED for OTP emails and password reset
# ---------------------------------------------------------------------------
# Supports any STARTTLS-capable SMTP provider (Gmail, SendGrid, Mailgun, etc.)
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourapp@gmail.com
#   SMTP_PASS=your-app-password  (use App Password, not your Gmail password)
#   SMTP_FROM=GAWA <noreply@yourdomain.com>
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxx
#   SMTP_FROM=GAWA <noreply@yourdomain.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
SMTP_FROM=GAWA <noreply@yourdomain.com>

# ---------------------------------------------------------------------------
# SMS Provider — REQUIRED for SMS OTP (optional if email OTP is sufficient)
# ---------------------------------------------------------------------------
# AUTH_VERIFICATION_POLICY options:
#   email_only  — Use email OTP only (default, no SMS credentials needed)
#   sms_only    — Use SMS OTP only  (requires SMS_PROVIDER + SMS_API_KEY)
#   both        — Require both email and SMS OTP
AUTH_VERIFICATION_POLICY=email_only

# SMS_PROVIDER options: "twilio" or "generic"
SMS_PROVIDER=twilio

# Twilio credentials:
#   SMS_API_KEY    = Auth Token
#   SMS_API_SECRET = Account SID
#   SMS_FROM       = Verified Twilio phone number (+63XXXXXXXXXX)
SMS_API_KEY=<twilio-auth-token>
SMS_API_SECRET=<twilio-account-sid>
SMS_FROM=+1XXXXXXXXXX

# Generic HTTP SMS Gateway (when SMS_PROVIDER=generic):
#   SMS_GATEWAY_URL = Full POST endpoint URL
#   SMS_API_KEY     = Bearer token or API key
SMS_GATEWAY_URL=https://api.your-sms-provider.com/v1/messages

# ---------------------------------------------------------------------------
# Application URLs — REQUIRED (production)
# ---------------------------------------------------------------------------
APP_BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ---------------------------------------------------------------------------
# External Services (configure before production launch)
# ---------------------------------------------------------------------------
# SERVICES REQUIRING CREDENTIALS BEFORE GOING LIVE:
#   1. Supabase project (database + auth)      → NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SECRET_KEY
#   2. Google OAuth (Google SSO)               → GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   3. SMTP provider (email OTP + reset links) → SMTP_HOST, SMTP_USER, SMTP_PASS
#   4. SMS provider (SMS OTP, optional)        → SMS_PROVIDER, SMS_API_KEY
#   5. TOTP encryption key (2FA secrets)       → TOTP_ENCRYPTION_KEY
#   6. Session secret (token signing)          → SESSION_SECRET
